{
  "functions": {
    "api/catalog.js": { "maxDuration": 300 },
    "api/snapshot.js": { "maxDuration": 300 },
    "api/bets.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/bets.html", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ]
}
